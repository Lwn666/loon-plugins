#!name=AgentRouter 每日签到
#!desc=agentrouter.org 中转站每日自动签到（登录即签到，每日领 $25 额度），8-12 点随机时间执行，支持多账号，主域名失败自动切备用域名 ps.air-outer.com，结果推送通知。
#!author=Minis
#!homepage=https://github.com/Lwn666/loon-plugins/tree/main/agentrouter
#!icon=https://agentrouter.org/favicon.ico
#!category=Sign
#!loon_version=3.5.1(983)

# ============================================================
# AgentRouter 每日签到
#
# 【站点机制】本站没有独立的「签到」接口，签到 = 每天第一次登录：
#   POST /api/user/login 时服务端顺带发放当日额度，
#   响应 data.checked_in = true，并在「使用日志」落一条
#   type=4 的「每日签到成功，增加额度 $25」记录。
#   官方 FAQ 原文：签到领 $25 额度 需要退出后重新登陆才会到账。
#   故本插件 = 用账号密码登录一次 + 回查日志确认。
#
# 【随机执行时间】
#   为避免每天固定时刻请求被判定为自动化：
#   - cron 每 15 分钟轮询（8-12 点）
#   - 当天首次轮询时生成一个随机时间点存入本地
#   - 到达该随机时间才真正登录签到
#   - 签到成功后当天剩余轮询静默退出
#   - 若 12 点后仍未签到（如 Loon 未运行）会自动补跑
#   窗口可用 RANDOM_WINDOW 调整。
#
# 【使用方法】
#   1. 在 Loon 插件参数 ACCOUNTS 里填写账号
#      单账号：邮箱#密码
#      多账号：每行一个，或用分号分隔
#      分隔符兼容 # 和 | 和 ----
#   2. 也可在 Loon 首页手动触发（通用脚本）
#
# 【注意】仅支持账号密码登录。GitHub 授权注册的账号
#        密码字段为空，需先设置密码才能用本插件。
# ============================================================

[Argument]
ACCOUNTS=input,"",tag=账号,desc=每行一个账号 邮箱和密码中间用井号连接 多账号换行或分号分隔
RANDOM_WINDOW=input,"08:00-12:00",tag=随机时间窗口,desc=格式 起始-结束 如 08:00-12:00。在此区间内随机选一个时刻执行
FORCE=switch,false,tag=立即执行,desc=开启后忽略随机窗口 立即签到（测试用 记得关）
MANUAL_RUN=switch,true,tag=手动触发立即执行,desc=首页手动点「手动签到」时忽略随机窗口直接跑 定时轮询不受影响
DEBUG=switch,false,tag=调试模式,desc=开启后输出详细日志

[Script]
# 定时轮询：每 15 分钟检查一次，到达当天随机时间才真正签到
# 注意：本条不传 MANUAL_RUN，脚本据此识别为定时轮询
cron "*/15 8-12 * * *" then script("https://raw.githubusercontent.com/Lwn666/loon-plugins/main/agentrouter/agentrouter-signin.js", {${ACCOUNTS}, ${RANDOM_WINDOW}, ${FORCE}, ${DEBUG}}) with tag="AgentRouter 自动签到", timeout=120, enable=true, debug=${DEBUG}

# 首页手动触发：传 MANUAL_RUN，忽略随机窗口与当日状态，立即执行并推送通知
generic then script("https://raw.githubusercontent.com/Lwn666/loon-plugins/main/agentrouter/agentrouter-signin.js", {${ACCOUNTS}, ${RANDOM_WINDOW}, ${FORCE}, ${DEBUG}, ${MANUAL_RUN}}) with tag="AgentRouter 手动签到", img_url="arrow.clockwise", timeout=120, enable=true, debug=${DEBUG}
