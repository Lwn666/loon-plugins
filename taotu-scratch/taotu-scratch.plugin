#!name=淘图社区 签到+自动续期
#!desc=EmbyPulse 社区（ue2.taotu.ink）每日自动签到；会员剩余天数不足时自动用积分兑换月卡续期；站点开启刮刮乐时可一并自动刮。账号密码只存手机端。
#!author=Lwn666
#!homepage=https://github.com/Lwn666/loon-plugins/blob/main/taotu-scratch/README.md
#!icon=https://raw.githubusercontent.com/Lwn666/loon-plugins/main/icons/taotu.png
#!category=Sign
#!system=iOS,iPadOS
#!loon_version=3.5.1(983)

# ============================================================
# 淘图 EmbyPulse 社区 · 每日签到 + 会员自动续期（+ 可选刮刮乐）
#
# 【接口】
#   登录   POST /api/requests/auth {"username","password"} → Set-Cookie: session_id
#   校验   GET  /api/requests/check            → {status,user{Name,expire_date}}
#   积分   GET  /api/user/points/info          → {data:{points,has_checked_in,config}}
#   签到   POST /api/user/points/checkin       → {status,reward,balance}
#   补给站 GET  /api/points/config             → {data:{store_items,enable_web_scratch,...}}
#   兑换   POST /api/user/points/redeem {item_id,request_id}
#   刮卡   POST /api/scratch/buy / reveal {cell_index}
#
# 【续期】会员剩余天数 ≤ 续期阈值（默认 30 天）时，用积分兑换「月卡」
#   （当前 3000 积分 / 30 天）。积分不足只发通知不扣分；
#   兑换带 request_id 幂等键，失败重试不会重复扣分。
#
# 【凭证】优先复用本地 session_id；失效自动用账号密码重新登录。
#
# 【手动运行】插件详情页底部「脚本」区 → 「淘图手动跑一次」
# ============================================================

[Argument]
USERNAME=input,"kkpkkp",tag=账号,desc=Emby 社区账号
PASSWORD=input,"",tag=密码,desc=必填 账号密码只存本机
RENEW=switch,true,tag=自动续期,desc=会员剩余天数不足时自动用积分兑换月卡
RENEW_DAYS=input,30,type=number,tag=续期阈值,desc=剩余天数≤该值时触发 默认30
MAXCARDS=input,0,type=number,tag=刮刮乐张数,desc=0=不刮（站点未开启时也会跳过）
NOTIFY=switch,true,tag=结果通知,desc=关闭后只在日志记录
CRONEXP=input,"5 8 * * *",tag=执行时间,desc=默认每天08:05

[Script]
cron ${CRONEXP} then script("https://raw.githubusercontent.com/Lwn666/loon-plugins/main/taotu-scratch/taotu-scratch.js", {${USERNAME}, ${PASSWORD}, ${RENEW}, ${RENEW_DAYS}, ${MAXCARDS}, ${NOTIFY}}) with tag="淘图自动签到+续期", timeout=300, enable=true

generic then script("https://raw.githubusercontent.com/Lwn666/loon-plugins/main/taotu-scratch/taotu-scratch.js", {${USERNAME}, ${PASSWORD}, ${RENEW}, ${RENEW_DAYS}, ${MAXCARDS}, ${NOTIFY}}) with tag="淘图手动跑一次", img_url="arrow.clockwise", timeout=300, enable=true
