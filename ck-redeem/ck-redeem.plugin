#!name=B站兑换码自动兑换
#!desc=复用 B 站 Cookie，捕获公益站登录态，定时检测 UP 主动态中的兑换码并自动兑换。凭证仅存手机端。
#!author=Lwn666
#!homepage=https://github.com/Lwn666/loon-plugins/blob/main/ck-redeem/README.md
#!icon=https://raw.githubusercontent.com/Lwn666/loon-plugins/main/icons/ck-redeem.png
#!system=iOS
#!loon_version=3.5.1(983)
#!tag=自动化,兑换
#!type=normal

# ============================================================
# B站兑换码自动兑换
#
# 【前置】已用「扫码Cookie」方式获取 B 站 Cookie
#        （存储 key: ck_bili_cookie）
# 【捕获】打开 api.910501.xyz 并登录 → 自动捕获 access_token
#        + refresh_token，持久化在手机端，不上传
# 【兑换】按 CRON 定时检测 UP 主动态中的兑换码，命中即自动兑换
# 【兜底】refresh_token 过期时，重开公益站任意页面即自动更新
# ============================================================

[Argument]
CRON=input,"*/2 * * * *",tag=检测频率,desc=默认每2分钟一次
ENABLE_CAPTURE=switch,true,tag=启用公益站登录态捕获,desc=打开公益站页面时自动更新登录态
ENABLE_REDEEM=switch,true,tag=启用自动兑换,desc=检测到兑换码时自动兑换
DEBUG=switch,false,tag=调试模式,desc=开启后输出详细日志

[Script]
# 公益站请求 Token 捕获（请求阶段）
request if ${url} ~= /^https:\/\/api\.910501\.xyz\/api\/v1/i then script("https://raw.githubusercontent.com/Lwn666/loon-plugins/main/ck-redeem/ck-capture.js", {${DEBUG}}) with tag="公益站Token捕获", timeout=10, requires_body=true, enable=${ENABLE_CAPTURE}

# 公益站登录/刷新/注册响应捕获（响应阶段）
response if ${url} ~= /^https:\/\/api\.910501\.xyz\/api\/v1\/auth\/(login|refresh|register)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/Lwn666/loon-plugins/main/ck-redeem/ck-capture.js", {${DEBUG}}) with tag="公益站登录态捕获", timeout=10, requires_body=true, enable=${ENABLE_CAPTURE}

# 定时检测兑换码并兑换
cron ${CRON} then script("https://raw.githubusercontent.com/Lwn666/loon-plugins/main/ck-redeem/redeem-task.js", {${DEBUG}}) with tag="兑换码检测兑换", timeout=120, enable=${ENABLE_REDEEM}

[Rule]
DOMAIN-SUFFIX,bilibili.com,DIRECT
DOMAIN,api.910501.xyz,DIRECT

[MITM]
hostname = api.910501.xyz
