#!name=小米淘淘小程序签到
#!desc=小米淘淘小程序每日自动签到。打开小程序自动续期凭证，定时签到并推送结果。
#!author=Minis
#!homepage=https://github.com/Lwn666/loon-plugins/tree/main/xiaomitaotao
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/97/40/5e/97405e49-87bb-3f0a-bf3a-91cf8fdf99a0/AppIcon-0-0-1x_U007epad-0-1-0-0-sRGB-GLES2_U002c0-85-220.png/144x144.png
#!category=Sign

[Argument]
CAPTURE_ENABLE=switch,true,tag=凭证自动捕获,desc=打开小程序时自动更新签到凭证
CRONEXP=input,"0 8 * * *",tag=自定义执行时间,desc=默认每天08:00执行 可自行更改
DEBUG=switch,false,tag=调试模式,desc=开启后输出详细日志

[Script]
# 凭证捕获：打开小程序时自动截获最新凭证写入持久存储
http-request ^https?:\/\/zsvip\.xomitoto\.com script-path=https://raw.githubusercontent.com/Lwn666/loon-plugins/main/xiaomitaotao/capture.js,tag=签到凭证捕获,requires-body=false,timeout=10,enable={CAPTURE_ENABLE},argument=[{DEBUG}]

# 定时签到（cron 表达式来自参数；timeout 固定 30s，不支持参数替换）
cron {CRONEXP} script-path=https://raw.githubusercontent.com/Lwn666/loon-plugins/main/xiaomitaotao/signin.js,tag=小米淘淘自动签到,timeout=30,enable=true,argument=[{DEBUG}]

[MITM]
hostname = zsvip.xomitoto.com