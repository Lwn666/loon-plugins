#!name=🌟 星驰API 公益站签到
#!desc=自动领取星驰API公益站每日签到额度并推送结果｜自动抓取站点令牌 无需手动维护
#!author=Lwn666
#!homepage=https://github.com/Lwn666/loon-plugins/blob/main/xingchiapi-signin/xingchiapi-signin.plugin
#!icon=https://raw.githubusercontent.com/Lwn666/loon-plugins/main/icons/xingchiapi.png
#!category=签到
#!system=iOS,iPadOS
#!loon_version=3.5.1(983)

[Argument]
RunTime = input,"5 8 * * *",tag=执行时间,desc=默认每天 08:05 签到 可自行更改
AccessToken = input,,tag=访问令牌·可选,desc=留空即可：打开一次站点自动抓取（24h 有效）。手动填 eyJ... 开头
RefreshToken = input,,tag=刷新令牌·可选,desc=填 rt_... 开头可长期自动续期；注意会与浏览器轮流换发令牌

[Script]
# 每日签到
cron {RunTime} script-path=https://raw.githubusercontent.com/Lwn666/loon-plugins/main/xingchiapi-signin/xingchiapi-signin.js, argument={${AccessToken},${RefreshToken}}, tag=星驰API每日签到, timeout=60, enable=true

# 登录/刷新时捕获令牌（需开启 MITM 与 Loon 证书）
http-response ^https?:\/\/api\.xingchiapi\.com\/api\/v1\/auth\/(login|refresh) script-path=https://raw.githubusercontent.com/Lwn666/loon-plugins/main/xingchiapi-signin/xingchiapi-capture.js, requires-body=true, timeout=10, tag=星驰API令牌捕获, enable=true

[MITM]
hostname = api.xingchiapi.com
