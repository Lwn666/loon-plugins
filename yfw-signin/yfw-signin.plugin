#!name=药房网自动签到
#!desc=m.yaofangwang.com 每日自动签到。打开签到页自动捕获 ASP.NET_SessionId，定时签到并推送结果。
#!author=Minis
#!homepage=https://github.com/Lwn666/loon-plugins/tree/main/yfw-signin
#!icon=https://m.yaofangwang.com/favicon.ico
#!category=Sign

[Argument]
CAPTURE_ENABLE=switch,true,tag=凭证自动捕获,desc=打开药房网页面时自动更新签到凭证
CRONEXP=input,"0 8 * * *",tag=自定义执行时间,desc=默认每天08:00执行 可自行更改
DEBUG=switch,false,tag=调试模式,desc=开启后输出详细日志

[Script]
# 凭证捕获：打开签到页时自动截获 ASP.NET_SessionId 写入持久存储
request if ${url} ~= /^https?:\/\/m\.yaofangwang\.com\/customer\/sign_ios\.html/i then script("https://raw.githubusercontent.com/Lwn666/loon-plugins/main/yfw-signin/capture.js", {${DEBUG}}) with tag="药房网凭证捕获", requires_body=false, timeout=10, enable=${CAPTURE_ENABLE}

# 定时签到（cron 表达式来自参数；timeout 固定 30s）
cron ${CRONEXP} then script("https://raw.githubusercontent.com/Lwn666/loon-plugins/main/yfw-signin/signin.js", {${DEBUG}}) with tag="药房网自动签到", timeout=30, enable=true

[MITM]
hostname = m.yaofangwang.com
