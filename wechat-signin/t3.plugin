#!name=微信签到-测试3: 全参数替换+generic
#!desc=测试 {TIMEOUT}/{DEBUG} 替换 + generic 脚本
#!author=Minis

[Argument]
CRONEXP=input,"0 8 * * *",tag=执行时间
DEBUG=switch,false,tag=调试
TIMEOUT=input,30,type=number,tag=超时

[Script]
http-request ^https?:\/\/zsvip\.xomitoto\.com script-path=https://raw.githubusercontent.com/Lwn666/loon-plugins/main/wechat-signin/capture.js,tag=捕获,timeout=10,enable=true,argument=[{DEBUG}]

cron {CRONEXP} script-path=https://raw.githubusercontent.com/Lwn666/loon-plugins/main/wechat-signin/signin.js,tag=自动签到,timeout={TIMEOUT},enable=true,argument=[{DEBUG}]

generic script-path=https://raw.githubusercontent.com/Lwn666/loon-plugins/main/wechat-signin/signin.js,tag=手动签到,timeout={TIMEOUT},enable=true,argument=[{DEBUG}]

[MITM]
hostname = zsvip.xomitoto.com