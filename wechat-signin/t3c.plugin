#!name=微信签到-测试3c: argument数组语法
#!desc=测试 argument=[{DEBUG}]
#!author=Minis

[Argument]
CRONEXP=input,"0 8 * * *",tag=执行时间
DEBUG=switch,false,tag=调试

[Script]
cron {CRONEXP} script-path=https://raw.githubusercontent.com/Lwn666/loon-plugins/main/wechat-signin/signin.js,tag=微信签到,timeout=30,enable=true,argument=[{DEBUG}]

[MITM]
hostname = zsvip.xomitoto.com