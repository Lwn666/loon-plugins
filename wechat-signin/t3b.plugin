#!name=微信签到-测试3b: timeout参数替换
#!desc=测试 timeout={TIMEOUT} 替换
#!author=Minis

[Argument]
CRONEXP=input,"0 8 * * *",tag=执行时间
TIMEOUT=input,30,type=number,tag=超时

[Script]
cron {CRONEXP} script-path=https://raw.githubusercontent.com/Lwn666/loon-plugins/main/wechat-signin/signin.js,tag=微信签到,timeout={TIMEOUT},enable=true

[MITM]
hostname = zsvip.xomitoto.com