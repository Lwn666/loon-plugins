#!name=微信签到-测试2: cron参数替换
#!desc=测试 {CRONEXP} 参数替换
#!author=Minis

[Argument]
CRONEXP=input,"0 8 * * *",tag=执行时间

[Script]
cron {CRONEXP} script-path=https://raw.githubusercontent.com/Lwn666/loon-plugins/main/wechat-signin/signin.js,tag=微信签到,timeout=30,enable=true

[MITM]
hostname = zsvip.xomitoto.com