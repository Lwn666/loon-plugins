#!name = 微电影付费墙解锁
#!desc = 解密微电影小程序(垂云通天河等)付费视频，旁路提取完整视频合成片段URL。AES-128-CBC(key=7749174464527483)已实测验证。
#!author = Minis
#!homepage = https://github.com/
#!system = iOS
#!system_version = 15
#!loon_version = 3.5.1(978)
